# /etc/gudocs/env 로 복사 후 실제 값으로 교체
# sudo install -m 600 -o ubuntu -g ubuntu env.example /etc/gudocs/env

DB_URL=jdbc:mysql://127.0.0.1:3306/gudocs
DB_USER=gudocs
DB_PASSWORD=CHANGE_ME

# 프론트 도메인 (콤마로 여러 개 가능)
CORS_ALLOWED_ORIGINS=https://gudocs-fe-v2.vercel.app

# 크로스 사이트 세션 쿠키 (HTTPS 필수)
COOKIE_SAME_SITE=none
COOKIE_SECURE=true

# 세션 장기 유지 (Spring Session JDBC — DB 저장이라 재배포/재기동에도 로그인 유지)
# SESSION_TIMEOUT: 미활동(idle) 만료. SESSION_COOKIE_MAX_AGE: 쿠키 수명(브라우저 종료 후에도 유지)
# 값 형식: 30d, 720h 등 (기본 30일)
SESSION_TIMEOUT=30d
SESSION_COOKIE_MAX_AGE=30d

# Google OAuth (Google Cloud Console에서 발급)
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME

# Kakao OAuth (Kakao Developers, REST API 키 / 보안 client_secret)
KAKAO_CLIENT_ID=CHANGE_ME
KAKAO_CLIENT_SECRET=CHANGE_ME

# Naver OAuth (Naver Developers, 애플리케이션 Client ID/Secret)
NAVER_CLIENT_ID=CHANGE_ME
NAVER_CLIENT_SECRET=CHANGE_ME

# 소셜 로그인 성공 후 리다이렉트할 프론트 주소
OAUTH_SUCCESS_REDIRECT=https://gudocs-fe-v2.vercel.app

# CLOVA OCR (Naver Cloud Platform General OCR)
CLOVA_OCR_INVOKE_URL=CHANGE_ME
CLOVA_OCR_SECRET_KEY=CHANGE_ME

# FCM Web Push
# 서비스 계정 JSON(GOOGLE_APPLICATION_CREDENTIALS 경로)이 실제로 존재해야 true로 켠다.
# (파일 없이 true면 앱 기동 시 크레덴셜 로드 실패로 죽는다)
# 배포(deploy.yml)에서는 GitHub Secret FIREBASE_SERVICE_ACCOUNT_JSON_BASE64 를 디코드해 이 파일을 만든다.
# 로컬에서 직접 켤 때: base64 -d 로 JSON을 위 경로에 저장 후 FIREBASE_ENABLED=true
FIREBASE_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=/etc/gudocs/firebase-service-account.json
FRONTEND_BASE_URL=https://gudocs-fe-v2.vercel.app
# 결제 예정 알림 스케줄러 cron (Asia/Seoul, 기본 매일 09:00)
FCM_NOTIFICATION_CRON=0 0 9 * * *
# 구독 검사 유도 알림 스케줄러 cron (Asia/Seoul, 기본 매일 09:10)
FCM_REVIEW_CRON=0 10 9 * * *